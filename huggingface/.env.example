# Hugging Face Space runtime example
#
# 用法：
# 1. 复制到 HF Storage 挂载目录：/data/.env
# 2. 或写入 Space Variables / Secrets（容器环境变量）
# 3. 常规运行时配置优先改 /data/config.toml
#
# 注意：不要把真实密钥提交到 Git。

# ==================== 路径 / 端口（HF 固定） ====================
DATA_DIR=/data
LOG_DIR=/data/logs
SERVER_HOST=0.0.0.0
SERVER_PORT=7860
SERVER_WORKERS=1

# ==================== 基础运行 ====================
TZ=Asia/Shanghai
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
ACCOUNT_SYNC_INTERVAL=30

# ==================== 账号存储 ====================
# local 数据落在 /data（需挂载 DanielleNguyen/Grok2Api-storage -> /data）
ACCOUNT_STORAGE=local
# ACCOUNT_LOCAL_PATH=/data/accounts.db

# 可选外置后端
# ACCOUNT_REDIS_URL=redis://:password@host:6379/0
# ACCOUNT_MYSQL_URL=mysql+aiomysql://user:password@host:3306/grok2api
# ACCOUNT_POSTGRESQL_URL=postgresql+asyncpg://user:password@host:5432/grok2api

# ==================== 访问控制（GROK_ 前缀覆盖 config.toml） ====================
# GROK_APP_APP_KEY=change_me_admin_password
# GROK_APP_API_KEY=sk-change_me
# GROK_APP_APP_URL=https://daniellenguyen-grok2api.hf.space
# GROK_APP_WEBUI_ENABLED=false
# GROK_APP_WEBUI_KEY=

# ==================== HF Space 元数据（可选，用于自动写 app_url） ====================
# SPACE_HOST 由 HF 注入时优先使用
# SPACE_HOST=daniellenguyen-grok2api.hf.space
# SPACE_ID=DanielleNguyen/Grok2Api
